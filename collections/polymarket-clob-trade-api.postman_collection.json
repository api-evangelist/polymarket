      "name": "CLOB Trade",
      "description": {
        "content": "Order placement and management on the central-limit order book.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "27124e25-34c2-487c-a48a-40ce39cb2c33",
          "name": "Post a new order",
          "request": {
            "name": "Post a new order",
            "description": {
              "content": "Submit a new signed order to the Polymarket CLOB.\nRequires the full POLY_* signed-request header set.\n",
              "type": "text/plain"
            },
            "url": {
              "protocol": "https",
              "path": [
                "order"
              ],
              "host": [
                "clob",
                "polymarket",
                "com"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": {
              "type": "apikey",
              "apikey": [
                {
                  "key": "key",
                  "value": "POLY_API_KEY"
                },
                {
                  "key": "value",
                  "value": "{{apiKey}}"
                },
                {
                  "key": "in",
                  "value": "header"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"order\": {\n    \"maker\": \"<string>\",\n    \"signer\": \"<string>\",\n    \"tokenId\": \"<string>\",\n    \"makerAmount\": \"<string>\",\n    \"takerAmount\": \"<string>\",\n    \"side\": \"<string>\",\n    \"expiration\": \"<string>\",\n    \"timestamp\": \"<string>\",\n    \"builder\": \"<string>\",\n    \"signature\": \"<string>\",\n    \"salt\": \"<string>\",\n    \"signatureType\": \"<integer>\"\n  },\n  \"owner\": \"<string>\",\n  \"orderType\": \"GTC\",\n  \"deferExec\": false,\n  \"postOnly\": false\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [
            {
              "id": "074bd311-1e10-4ca7-b817-fd90dd72dddd",
              "name": "Order acknowledgement",
              "originalRequest": {
                "url": {
                  "protocol": "https",
                  "path": [
                    "order"
                  ],
                  "host": [
                    "clob",
                    "polymarket",
                    "com"
                  ],
                  "query": [],
                  "variable": []
                },
