                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"order\": {\n    \"maker\": \"string\",\n    \"signer\": \"string\",\n    \"tokenId\": \"string\",\n    \"makerAmount\": \"string\",\n    \"takerAmount\": \"string\",\n    \"side\": \"SELL\",\n    \"expiration\": \"string\",\n    \"timestamp\": \"string\",\n    \"builder\": \"string\",\n    \"signature\": \"string\",\n    \"salt\": \"string\",\n    \"signatureType\": 8055\n  },\n  \"owner\": \"<string>\",\n  \"orderType\": \"GTC\",\n  \"deferExec\": false,\n  \"postOnly\": false\n}",
                  "options": {
